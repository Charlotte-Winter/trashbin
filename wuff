// Erste Zeile MUSS ein Kommentar sein! Fügt Username, Live-Uhr und echten Linux-Netzwerk-Speed in die TabsToolbar ein.
try { 
  Services.obs.addObserver(function(win, topic) { 
    if (topic === "domwindowopened") { 
      win.addEventListener("DOMContentLoaded", function() { 
        if (win.document.documentElement.getAttribute("windowtype") === "navigator:browser") { 
          
          // 1. Linux-Benutzernamen an die Adressleiste übergeben 
          let username = Services.env.get("USER") || Services.env.get("USERNAME") || "user"; 
          let identityBox = win.document.getElementById("identity-box"); 
          if (identityBox) { 
            identityBox.setAttribute("data-username", username); 
          } 
          
          let tabsBar = win.document.getElementById("TabsToolbar"); 
          if (tabsBar) {
            // 2. Live-Uhr in die TabsToolbar einfügen 
            if (!win.document.getElementById("time_label")) { 
              let clock = win.document.createElement("div"); 
              clock.id = "time_label"; 
              
              let updateClock = function() { 
                let now = new Date(); 
                clock.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }); 
              }; 
              
              updateClock(); 
              win.setInterval(updateClock, 1000); 
              tabsBar.appendChild(clock); 
            } 

            // 2b. Echte Linux-Netzwerkinformationen / Up- & Download-Element einfügen
            if (!win.document.getElementById("net_speed_label")) {
              let netSpeed = win.document.createElement("div");
              netSpeed.id = "net_speed_label";
              netSpeed.style.marginLeft = "10px";
              netSpeed.style.display = "inline-block";
              netSpeed.textContent = "↑ 0 KB/s  ↓ 0 KB/s";
              
              // Hilfsfunktion: Schaltet automatisch ab 1024 KB/s auf MB/s um
              let formatSpeed = function(bytesPerSec) {
                let kb = bytesPerSec / 1024;
                if (kb >= 1024) {
                  return (kb / 1024).toFixed(1) + " MB/s";
                }
                return kb.toFixed(1) + " KB/s";
              };
              
              let lastRx = 0;
              let lastTx = 0;
              let lastTime = Date.now();

              let updateNetSpeed = async function() {
                try {
                  // Liest die echten Netzwerkschnittstellen-Daten von Linux aus
                  let content = await IOUtils.readUTF8("/proc/net/dev");
                  let lines = content.split("\n");
                  let rxBytes = 0;
                  let txBytes = 0;

                  for (let line of lines) {
                    if (line.includes(":")) {
                      let parts = line.split(":");
                      let iface = parts[0].trim();
                      // Loopback (lo) ignorieren, alle anderen Interfaces (Ethernet, WLAN) summieren
                      if (iface !== "lo") {
                        let data = parts[1].trim().split(/\s+/);
                        rxBytes += parseInt(data[0], 10) || 0; // Empfangene Bytes (Download)
                        txBytes += parseInt(data[8], 10) || 0; // Gesendete Bytes (Upload)
                      }
                    }
                  }

                  let now = Date.now();
                  let elapsed = (now - lastTime) / 1000; // Vergangene Zeit in Sekunden

                  if (elapsed > 0 && lastRx > 0) {
                    let downSpeed = (rxBytes - lastRx) / elapsed; // Bytes pro Sekunde
                    let upSpeed = (txBytes - lastTx) / elapsed;     // Bytes pro Sekunde
                    
                    netSpeed.textContent = `↑ ${formatSpeed(upSpeed)}  ↓ ${formatSpeed(downSpeed)}`;
                  }

                  lastRx = rxBytes;
                  lastTx = txBytes;
                  lastTime = now;
                } catch (e) {
                  // Fallback falls das Auslesen fehlschlägt
                }
              };
              
              updateNetSpeed();
              win.setInterval(updateNetSpeed, 1000);
              tabsBar.appendChild(netSpeed);
            }
          }

        } 
      }, { once: true }); 
    } 
  }, "nodewindowopened", false); // (Hinweis: domwindowopened bleibt erhalten)
} catch(e) {}
