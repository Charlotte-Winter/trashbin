// Erste Zeile MUSS ein Kommentar sein! Fügt Username, Live-Uhr und Netzwerk-Speed in die TabsToolbar ein.
try { 
  Services.obs.addObserver(function(win, topic) { 
    if (topic === "domwindowopened") { 
      win.addEventListener("DOMContentLoaded", function() { 
        if (win.document.documentElement.getAttribute("windowtype") === "navigator:browser") { 
          
          // 1. Windows-Benutzernamen an die Adressleiste übergeben 
          let username = Services.env.get("USERNAME") || "user"; 
          let identityBox = win.document.getElementById("identity-box"); 
          if (identityBox) { 
            identityBox.setAttribute("data-username", username); 
          } 
          
          let tabsBar = win.document.getElementById("TabsToolbar"); 
          if (tabsBar) {
            // 2. Live-Uhr in die TabsToolbar einfügen 
            if (!win.document.getElementById("time_label")) { 
              let clock = win.document.createElement("div"); 
              clock.id = "time_label"; 
              
              let updateClock = function() { 
                let now = new Date(); 
                clock.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }); 
              }; 
              
              updateClock(); 
              win.setInterval(updateClock, 1000); 
              tabsBar.appendChild(clock); 
            } 

            // 2b. Netzinformationen / Up- & Download-Element einfügen
            if (!win.document.getElementById("net_speed_label")) {
              let netSpeed = win.document.createElement("div");
              netSpeed.id = "net_speed_label";
              netSpeed.style.marginLeft = "10px";
              netSpeed.style.display = "inline-block";
              
              // NEU: Hilfsfunktion zur automatischen Formatierung (schaltet ab 1024 KB/s auf MB/s um)
              let formatSpeed = function(kb) {
                if (kb >= 1024) {
                  return (kb / 1024).toFixed(1) + " MB/s";
                }
                return kb.toFixed(1) + " KB/s";
              };
              
              let updateNetSpeed = function() {
                // NEU: Wertebereich erhöht (z.B. bis 2500 KB/s = ~2.4 MB/s), damit MB/s erreicht werden können
                let up = Math.random() * 1500;     // Zufallswert in KB/s
                let down = Math.random() * 3500;   // Zufallswert in KB/s
                
                netSpeed.textContent = `↑ ${formatSpeed(up)}  ↓ ${formatSpeed(down)}`;
              };
              
              updateNetSpeed();
              win.setInterval(updateNetSpeed, 1000);
              tabsBar.appendChild(netSpeed);
            }
          }

        } 
      }, { once: true }); 
    } 
  }, "domwindowopened", false); 
} catch(e) {}
